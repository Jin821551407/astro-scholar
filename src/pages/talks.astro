---
import Layout from '../layouts/Layout.astro';
---

<Layout pageTitle="技术分享 | 阿劲的数字工坊">
  <div class="page-container talks-page">
    <!-- 头部区域 -->
    <header class="talks-header">
      <h1>🎙️ 技术分享</h1>
      <p class="intro-text">
        这里是我的“数字会客厅”。未来会在这里记录 Meetup、团队内部分享与线上直播的干货。<br />
        目前会议室正在布置中，茶水已备好，只等干货上场！
      </p>
    </header>

    <!-- 核心区域：白板占位符 -->
    <div class="whiteboard-container">
      <div class="whiteboard">
        <div class="board-header">
          <span class="icon">📅</span>
          <span class="title">下一场 Meetup</span>
        </div>

        <div class="board-content">
          <!-- 黄色便签纸效果 -->
          <div class="sticky-note">
            <div class="tape"></div> <!-- 透明胶带装饰 -->
            <h3>🚧 筹备中...</h3>
            <p>
              阿劲正在疯狂打磨 Slides 与实战代码。<br />
              座位已经留好，敬请期待！
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 互动区：留言催更 -->
    <div class="interaction-area">
      <h3>💬 你想听什么主题？</h3>
      <p>
        欢迎在下方留言，或者通过邮件告诉我，我来安排下一场分享！<br />
        <a href="mailto:your-email@example.com" class="action-link">给我发邮件</a>
        <span class="separator">或</span>
        <a href="/guestbook" class="action-link">去留言板</a>
      </p>
    </div>
  </div>
</Layout>

<style>
  /* 页面整体容器微调 */
  .talks-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  /* 头部样式 */
  .talks-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .talks-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .intro-text {
    color: #666;
    line-height: 1.8;
    font-size: 1.1rem;
  }

  /* --- 白板容器 (拟物化卡片) --- */
  .whiteboard-container {
    margin-bottom: 3rem;
    perspective: 1000px; /* 增加一点3D透视感 */
  }

  .whiteboard {
    background: #ffffff;
    border-radius: 12px;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 0 0 1px rgba(0, 0, 0, 0.05); /* 极细边框 */
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .whiteboard:hover {
    transform: translateY(-2px); /* 悬浮微动效 */
  }

  /* 白板顶部栏 */
  .board-header {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #475569;
    font-size: 0.9rem;
  }

  .board-content {
    padding: 3rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
    background-image: radial-gradient(#e5e7eb 1px, transparent 1px); /* 点阵背景，像笔记本 */
    background-size: 20px 20px;
  }

  /* --- 黄色便签纸 (Sticky Note) --- */
  .sticky-note {
    background-color: #fef08a; /* 经典的黄色便签色 */
    color: #422006;
    padding: 1.5rem 2rem;
    width: 100%;
    max-width: 400px;
    box-shadow: 2px 4px 6px rgba(0, 0, 0, 0.15);
    transform: rotate(-2deg); /* 微微倾斜，更自然 */
    position: relative;
    font-family: 'Comic Sans MS', 'Chalkboard SE', sans-serif; /* 手写风格字体 */
  }

  .sticky-note h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
  }

  .sticky-note p {
    margin: 0;
    line-height: 1.6;
    font-size: 1rem;
  }

  /* 透明胶带装饰 */
  .tape {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 25px;
    background-color: rgba(255, 255, 255, 0.4);
    border-left: 1px dashed rgba(255, 255, 255, 0.5);
    border-right: 1px dashed rgba(255, 255, 255, 0.5);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  /* --- 底部互动区 --- */
  .interaction-area {
    text-align: center;
    padding: 2rem;
    background: #f1f5f9;
    border-radius: 8px;
  }

  .interaction-area h3 {
    margin-top: 0;
    color: #334155;
  }

  .action-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px dashed #2563eb;
    transition: all 0.2s;
  }

  .action-link:hover {
    background: #2563eb;
    color: white;
    border-bottom-style: solid;
  }

  .separator {
    margin: 0 0.5rem;
    color: #94a3b8;
  }
</style>